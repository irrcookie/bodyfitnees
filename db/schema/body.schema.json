{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irrcookie.github.io/bodyfitnees/db/schema/body.schema.json",
  "title": "身體紀錄",
  "description": "小米體脂磅人體成分報告。Git 內 JSON 即資料庫。",
  "type": "object",
  "required": ["version", "records"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/bodyRecord" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["標準", "偏高", "偏低", "不足", "稍多", "過高", "過低", "未知"]
    },
    "bodyRecord": {
      "type": "object",
      "required": ["id", "measuredAt", "source", "weightKg"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "measuredAt": { "type": "string", "description": "量度時間 ISO 8601，含時區" },
        "source": { "type": "string", "enum": ["xiaomi", "ocr", "manual", "chat", "issue"] },
        "device": { "type": "string" },
        "notes": { "type": "string" },
        "weightKg": { "type": "number" },
        "weightStatus": { "$ref": "#/$defs/status" },
        "weightTrendNote": { "type": "string" },
        "weightDelta150d": { "type": ["number", "null"] },
        "bodyScore": { "type": ["integer", "null"] },
        "recommendation": { "type": "string" },
        "bmi": { "type": ["number", "null"] },
        "bmiDelta": { "type": ["number", "null"] },
        "bmiStatus": { "$ref": "#/$defs/status" },
        "bodyFatPercent": { "type": ["number", "null"] },
        "bodyFatDelta": { "type": ["number", "null"] },
        "bodyFatStatus": { "$ref": "#/$defs/status" },
        "bodyWaterKg": { "type": ["number", "null"] },
        "fatMassKg": { "type": ["number", "null"] },
        "boneSaltKg": { "type": ["number", "null"] },
        "proteinMassKg": { "type": ["number", "null"] },
        "muscleMassKg": { "type": ["number", "null"] },
        "muscleMassDelta": { "type": ["number", "null"] },
        "muscleMassStatus": { "$ref": "#/$defs/status" },
        "muscleRatePercent": { "type": ["number", "null"] },
        "muscleRateDelta": { "type": ["number", "null"] },
        "muscleRateStatus": { "$ref": "#/$defs/status" },
        "bodyWaterPercent": { "type": ["number", "null"] },
        "bodyWaterDelta": { "type": ["number", "null"] },
        "bodyWaterStatus": { "$ref": "#/$defs/status" },
        "proteinRatePercent": { "type": ["number", "null"] },
        "proteinRateDelta": { "type": ["number", "null"] },
        "proteinRateStatus": { "$ref": "#/$defs/status" },
        "boneSaltRatePercent": { "type": ["number", "null"] },
        "boneSaltRateDelta": { "type": ["number", "null"] },
        "boneSaltRateStatus": { "$ref": "#/$defs/status" },
        "skeletalMuscleKg": { "type": ["number", "null"] },
        "skeletalMuscleDelta": { "type": ["number", "null"] },
        "skeletalMuscleStatus": { "$ref": "#/$defs/status" },
        "visceralFatLevel": { "type": ["number", "null"] },
        "visceralFatDelta": { "type": ["number", "null"] },
        "visceralFatStatus": { "$ref": "#/$defs/status" },
        "bmrKcal": { "type": ["integer", "null"] },
        "bmrDelta": { "type": ["number", "null"] },
        "bmrStatus": { "$ref": "#/$defs/status" },
        "waistHipRatio": { "type": ["number", "null"] },
        "waistHipDelta": { "type": ["number", "null"] },
        "waistHipStatus": { "$ref": "#/$defs/status" },
        "bodyAge": { "type": ["integer", "null"] },
        "bodyAgeDelta": { "type": ["number", "null"] },
        "fatFreeMassKg": { "type": ["number", "null"] },
        "fatFreeMassDelta": { "type": ["number", "null"] },
        "heartRateBpm": { "type": ["integer", "null"] },
        "heartRateStatus": { "$ref": "#/$defs/status" },
        "bodyType": { "type": "string" },
        "standardWeightKg": { "type": ["number", "null"] },
        "weightControlKg": { "type": ["number", "null"] },
        "fatControlKg": { "type": ["number", "null"] },
        "muscleControl": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
